# Backend Server Configuration
PORT=8080

# GitHub OAuth Credentials
# Retrieve these from your GitHub Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Redirect callback URL (must match the one registered in GitHub)
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# Allowed origins for CORS (deployed frontend URL)
FRONTEND_URL=http://localhost:5173
